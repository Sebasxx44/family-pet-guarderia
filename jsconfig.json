{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/components/*": ["./public/components/*"],
      "@/composables/*": ["./public/composables/*"],
      "@/types": ["./src/types.ts"]
    }
  },
  "include": ["public/**/*.js", "src/types.ts"]
}
